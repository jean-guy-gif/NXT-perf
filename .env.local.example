# ── Supabase ────────────────────────────────────────────────────────────────
# Identifiants projet (https://supabase.com/dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Interrupteur IA ───────────────────────────────────────────────────────────
# Éteints par défaut : aucune fonctionnalité IA, aucun appel LLM.
# Serveur — autorise réellement les appels LLM (routes API) :
AI_FEATURES_ENABLED=false
# Client — affiche les boutons / composants qui déclenchent l'IA :
NEXT_PUBLIC_AI_FEATURES=off

# Option B — clé OpenRouter, requise uniquement si l'IA est activée ci-dessus.
# OPENROUTER_API_KEY=sk-or-v1-...

# ── Mode application ──────────────────────────────────────────────────────────
# Laisser vide pour le mode normal. "formation" : stagiaires conseillers /
# managers uniquement (rôles directeur, réseau, coach, admin masqués).
# NEXT_PUBLIC_APP_MODE=formation
